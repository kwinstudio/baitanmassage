{
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tarieven",
      "destination": "/prijzen",
      "permanent": true
    },
    {
      "source": "/tarieven/",
      "destination": "/prijzen",
      "permanent": true
    },
    {
      "source": "/online-reserveren",
      "destination": "https://baitan-thai-massage.salonized.com/services",
      "permanent": true
    },
    {
      "source": "/online-reserveren/",
      "destination": "https://baitan-thai-massage.salonized.com/services",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/algemene-voorwaarden",
      "destination": "/voorwaarden",
      "permanent": true
    },
    {
      "source": "/algemene-voorwaarden/",
      "destination": "/voorwaarden",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/assets/images/baitan-hero-atmospheric.webp",
      "destination": "/assets/images/thaise-massage-capelle-aan-den-ijssel.webp",
      "permanent": true
    },
    {
      "source": "/assets/images/thai-oil-massage.webp",
      "destination": "/assets/images/aromatherapie-oliemassage.webp",
      "permanent": true
    },
    {
      "source": "/assets/images/thai-leg-massage.webp",
      "destination": "/assets/images/sportmassage-kuiten.webp",
      "permanent": true
    },
    {
      "source": "/assets/images/hot-stone-massage.webp",
      "destination": "/assets/images/hot-stone-massage-warme-stenen.webp",
      "permanent": true
    },
    {
      "source": "/assets/images/thai-back-massage.webp",
      "destination": "/assets/images/duo-massage-rug-schouders.webp",
      "permanent": true
    },
    {
      "source": "/assets/images/thai-hand-massage.webp",
      "destination": "/assets/images/body-scrub-massage-handen.webp",
      "permanent": true
    },
    {
      "source": "/assets/images/thai-herbal-compress.webp",
      "destination": "/assets/images/thaise-kruidenstempel-massage.webp",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(fonts|assets/images/r)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles.css|app.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}